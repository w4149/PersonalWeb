{
  "name": "personal-sites-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:deng-manyuan": "npm run dev --workspace @personal-sites/deng-manyuan",
    "dev:xie-yike": "npm run dev --workspace @personal-sites/xie-yike",
    "build:deng-manyuan": "npm run build --workspace @personal-sites/deng-manyuan",
    "build:xie-yike": "npm run build --workspace @personal-sites/xie-yike",
    "build:all": "npm run build --workspaces --if-present"
  }
}
